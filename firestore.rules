rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function allowedEmail() {
      return signedIn() && request.auth.token.email in ['tatakai.javkhaa@gmail.com', 'trader.jabu@gmail.com'];
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId && allowedEmail();
    }

    function validTransaction(data, userId, transactionId) {
      return data.keys().hasAll(['id', 'type', 'amount', 'category', 'date', 'note', 'createdAt', 'userId'])
        && data.id == transactionId
        && data.userId == userId
        && data.type in ['income', 'expense']
        && data.amount is number
        && data.amount > 0
        && data.amount <= 100000000000
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 100
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.note is string
        && data.note.size() <= 500
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow read, write: if ownsUser(userId);

      match /transactions/{transactionId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && validTransaction(request.resource.data, userId, transactionId);
        allow update: if ownsUser(userId)
          && resource.data.userId == userId
          && request.resource.data.userId == resource.data.userId
          && validTransaction(request.resource.data, userId, transactionId);
        allow delete: if ownsUser(userId) && resource.data.userId == userId;
      }
    }
  }
}
